APP_NAME=EMC
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
APP_VERSION=1.0.0
FRONTEND_URL=https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=${FRONTEND_URL}
SANCTUM_STATEFUL_DOMAINS=app.yourdomain.com
FRONTEND_PAYMENT_SUCCESS_URL=${FRONTEND_URL}/payment/success
FRONTEND_PAYMENT_CANCEL_URL=${FRONTEND_URL}/payment/cancel

# PHPUnit uses DB from phpunit.xml (default MySQL database emc_testing). Create it locally or change phpunit.xml.
# Allow fake payment_provider when APP_ENV=testing (for automated tests only; keep false in .env).
ALLOW_FAKE_PAYMENTS_IN_TESTING=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emc_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Queue ────────────────────────────────────────────────────────────────────
# Use "redis" in production (requires Redis running + Supervisor workers).
# Use "database" as fallback if Redis is not yet configured.
# Use "sync" in local dev only (no worker needed, jobs run inline).
QUEUE_CONNECTION=redis

# ─── Realtime notification broadcasting ────────────────────────────────────────
# Use "null" (default, no external process) until a Reverb server is deployed.
# Use "reverb" in production once `php artisan reverb:start` is supervised and
# REVERB_* is filled in — see docs/architecture/ADR_NOTIFICATION_ARCHITECTURE.md.
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Push notifications (Web Push / VAPID) ─────────────────────────────────────
# Leave empty to keep push disabled (safe no-op). Generate a VAPID keypair to enable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@example.com"

# ─── SMS ────────────────────────────────────────────────────────────────────────
# Supported: "log" (default, no real messages), "twilio".
SMS_PROVIDER=log
SMS_TWILIO_SID=
SMS_TWILIO_TOKEN=
SMS_TWILIO_FROM=

# ─── Cache ────────────────────────────────────────────────────────────────────
# Use "redis" in production for KPI caching, session, and rate limiting.
# Use "database" as fallback. Never use "array" (in-memory, not shared).
CACHE_STORE=redis
# CACHE_PREFIX=emc_

MEMCACHED_HOST=127.0.0.1

# ─── Redis ────────────────────────────────────────────────────────────────────
# Uses predis (pure PHP, no extension required): composer require predis/predis
# phpredis extension is faster but requires server-level installation.
# Change REDIS_CLIENT=phpredis if the phpredis PHP extension is available.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@edumc.nl"
MAIL_FROM_NAME="EMC"
MAIL_SUPPORT_ADDRESS=support@edumc.nl
MAIL_SUPPORT_NAME="EMC Support"
DESIGNER_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum token lifetime in minutes. 1440 = 24 hours.
SANCTUM_TOKEN_EXPIRATION=1440

VITE_APP_NAME="${APP_NAME}"
STRIPE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_CURRENCY=eur

PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=your_sandbox_client_id
PAYPAL_SANDBOX_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_SANDBOX_APP_ID=APP-80W284485P519543T
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_APP_ID=
PAYPAL_CURRENCY=EUR
PAYPAL_NOTIFY_URL=
PAYPAL_LOCALE=en_US
PAYPAL_WEBHOOK_ID=

# ─── Error Tracking (Sentry) ──────────────────────────────────────────────────
# Requires: composer require sentry/sentry-laravel
# Get your DSN from https://sentry.io → Project Settings → Client Keys
# Add 'sentry' to LOG_STACK once DSN is set: LOG_STACK=daily,sentry
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_LOG_LEVEL=error

# ─── Scheduler & Backups ──────────────────────────────────────────────────────
# Set to true to run emc:backup --db --prune-days=30 every night at 01:00
ENABLE_SCHEDULED_BACKUP=false
